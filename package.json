{
  "name": "guerdolandia",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A tamagotchi of yourself: gamified self-kindness with quests, a calendar and a focus timer.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
