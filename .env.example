# Google OAuth 2.0 Web client ID (Google Cloud Console → APIs & Services → Credentials).
# Enable the Google Calendar API on the same project and add your site's origin
# (e.g. http://localhost:5173) under "Authorized JavaScript origins".
# You can also paste the client ID into the app's Settings screen instead.
VITE_GOOGLE_CLIENT_ID=

# Set to 1 when building the single-file embedded version (no downloads available).
VITE_EMBEDDED=
